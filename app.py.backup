import os
from functools import wraps

from flask import (
    Flask, render_template, request, redirect,
    url_for, flash, session
)
from werkzeug.security import check_password_hash, generate_password_hash

from database import get_connection
from blockchain import calculate_record_hash, store_hash_on_blockchain, verify_hash_on_blockchain


app = Flask(__name__)
app.secret_key = os.getenv(
    "FLASK_SECRET_KEY",
    "MedicalChain-Demo-Secret-Change-Before-Production"
)


# ---------------- AUTHENTICATION ----------------

def login_required(function):
    @wraps(function)
    def wrapper(*args, **kwargs):
        if "user_id" not in session:
            flash("Please log in first.", "error")
            return redirect(url_for("login"))
        return function(*args, **kwargs)
    return wrapper


def role_required(required_role):
    def decorator(function):
        @wraps(function)
        def wrapper(*args, **kwargs):
            if "user_id" not in session:
                flash("Please log in first.", "error")
                return redirect(url_for("login"))

            if session.get("role") != required_role:
                flash("You are not authorized to access that page.", "error")
                return redirect(url_for("dashboard"))

            return function(*args, **kwargs)
        return wrapper
    return decorator


@app.route("/")
def index():
    if "user_id" in session:
        return redirect(url_for("dashboard"))
    return redirect(url_for("login"))


@app.route("/login", methods=["GET", "POST"])
def login():
    if "user_id" in session:
        return redirect(url_for("dashboard"))

    if request.method == "POST":
        email = request.form.get("email", "").strip().lower()
        password = request.form.get("password", "")

        connection = get_connection()
        cursor = connection.cursor(dictionary=True)

        cursor.execute("""
            SELECT
                u.user_id,
                u.email,
                u.password_hash,
                u.role,
                u.patient_id,
                u.doctor_id,
                p.name AS patient_name,
                d.name AS doctor_name
            FROM users u
            LEFT JOIN patients p ON u.patient_id = p.patient_id
            LEFT JOIN doctors d ON u.doctor_id = d.doctor_id
            WHERE u.email = %s
        """, (email,))

        user = cursor.fetchone()
        cursor.close()
        connection.close()

        if user and check_password_hash(user["password_hash"], password):
            session.clear()
            session["user_id"] = user["user_id"]
            session["email"] = user["email"]
            session["role"] = user["role"]
            session["patient_id"] = user["patient_id"]
            session["doctor_id"] = user["doctor_id"]
            session["display_name"] = (
                user["doctor_name"] if user["role"] == "doctor"
                else user["patient_name"]
            )

            return redirect(url_for("dashboard"))

        flash("Invalid email or password.", "error")

    return render_template("login.html")


@app.route("/logout")
@login_required
def logout():
    session.clear()
    flash("You have been logged out.", "success")
    return redirect(url_for("login"))


@app.route("/dashboard")
@login_required
def dashboard():
    if session["role"] == "doctor":
        return redirect(url_for("doctor_dashboard"))
    return redirect(url_for("patient_dashboard"))


# ---------------- DOCTOR PORTAL ----------------

@app.route("/doctor")
@role_required("doctor")
def doctor_dashboard():
    connection = get_connection()
    cursor = connection.cursor(dictionary=True)

    doctor_id = session["doctor_id"]

    cursor.execute("""
        SELECT COUNT(*) AS total
        FROM doctor_patient
        WHERE doctor_id = %s
    """, (doctor_id,))
    total_patients = cursor.fetchone()["total"]

    cursor.execute("""
        SELECT COUNT(*) AS total
        FROM medical_records mr
        JOIN doctor_patient dp ON mr.patient_id = dp.patient_id
        WHERE dp.doctor_id = %s
    """, (doctor_id,))
    total_records = cursor.fetchone()["total"]

    cursor.execute("""
        SELECT
            p.patient_id, p.name, p.age, p.gender, p.phone
        FROM patients p
        JOIN doctor_patient dp ON p.patient_id = dp.patient_id
        WHERE dp.doctor_id = %s
        ORDER BY p.name
    """, (doctor_id,))
    patients = cursor.fetchall()

    cursor.execute("""
        SELECT
            mr.record_id, mr.diagnosis, mr.doctor_name,
            mr.created_at, p.name AS patient_name
        FROM medical_records mr
        JOIN patients p ON mr.patient_id = p.patient_id
        JOIN doctor_patient dp ON dp.patient_id = p.patient_id
        WHERE dp.doctor_id = %s
        ORDER BY mr.record_id DESC
        LIMIT 6
    """, (doctor_id,))
    recent_records = cursor.fetchall()

    cursor.close()
    connection.close()

    return render_template(
        "doctor_dashboard.html",
        total_patients=total_patients,
        total_records=total_records,
        patients=patients,
        recent_records=recent_records
    )


@app.route("/doctor/patients/add", methods=["GET", "POST"])
@role_required("doctor")
def add_patient():
    if request.method == "POST":
        name = request.form.get("name", "").strip()
        email = request.form.get("email", "").strip().lower()
        age = request.form.get("age", "").strip()
        gender = request.form.get("gender", "").strip()
        phone = request.form.get("phone", "").strip()
        password = request.form.get("password", "")

        if not all([name, email, password]):
            flash("Name, email and password are required.", "error")
            return redirect(url_for("add_patient"))

        if len(password) < 8:
            flash("Password must contain at least 8 characters.", "error")
            return redirect(url_for("add_patient"))

        try:
            age_value = int(age) if age else None
            if age_value is not None and not 0 <= age_value <= 130:
                raise ValueError("Age must be between 0 and 130.")

            connection = get_connection()
            cursor = connection.cursor()

            cursor.execute("""
                INSERT INTO patients (name, age, gender, phone)
                VALUES (%s, %s, %s, %s)
            """, (name, age_value, gender, phone))

            patient_id = cursor.lastrowid

            cursor.execute("""
                INSERT INTO users (email, password_hash, role, patient_id)
                VALUES (%s, %s, 'patient', %s)
            """, (
                email,
                generate_password_hash(password),
                patient_id
            ))

            cursor.execute("""
                INSERT INTO doctor_patient (doctor_id, patient_id)
                VALUES (%s, %s)
            """, (session["doctor_id"], patient_id))

            connection.commit()
            cursor.close()
            connection.close()

            flash(
                f"Patient registered successfully. Patient ID: {patient_id}",
                "success"
            )
            return redirect(url_for("doctor_dashboard"))

        except ValueError as error:
            flash(str(error), "error")
        except Exception as error:
            if "connection" in locals() and connection.is_connected():
                connection.rollback()
                connection.close()
            flash("Could not register patient. Check whether the email is already used.", "error")

    return render_template("add_patient.html")


@app.route("/doctor/records/add", methods=["GET", "POST"])
@role_required("doctor")
def add_record():
    connection = get_connection()
    cursor = connection.cursor(dictionary=True)

    cursor.execute("""
        SELECT p.patient_id, p.name
        FROM patients p
        JOIN doctor_patient dp ON dp.patient_id = p.patient_id
        WHERE dp.doctor_id = %s
        ORDER BY p.name
    """, (session["doctor_id"],))

    patients = cursor.fetchall()

    cursor.execute(
        "SELECT name FROM doctors WHERE doctor_id = %s",
        (session["doctor_id"],)
    )
    doctor = cursor.fetchone()
    doctor_name = doctor["name"] if doctor else "Doctor"

    cursor.close()
    connection.close()

    if request.method == "POST":
        try:
            patient_id = int(request.form.get("patient_id", "0"))
            diagnosis = request.form.get("diagnosis", "").strip()
            prescription = request.form.get("prescription", "").strip()

            if not diagnosis:
                flash("Diagnosis is required.", "error")
                return redirect(url_for("add_record"))

            connection = get_connection()
            cursor = connection.cursor()

            cursor.execute("""
                SELECT assignment_id
                FROM doctor_patient
                WHERE doctor_id = %s AND patient_id = %s
            """, (session["doctor_id"], patient_id))

            if not cursor.fetchone():
                flash("This patient is not assigned to your account.", "error")
                cursor.close()
                connection.close()
                return redirect(url_for("add_record"))

            cursor.execute("""
                INSERT INTO medical_records
                (patient_id, diagnosis, prescription, doctor_name)
                VALUES (%s, %s, %s, %s)
            """, (patient_id, diagnosis, prescription, doctor_name))

            record_id = cursor.lastrowid
            connection.commit()

            record_data = {
                "record_id": int(record_id),
                "patient_id": int(patient_id),
                "diagnosis": diagnosis,
                "prescription": prescription,
                "doctor_name": doctor_name
            }

            record_hash = calculate_record_hash(record_data)

            try:
                transaction_hash = store_hash_on_blockchain(
                    record_id, record_hash
                )

                cursor.execute("""
                    UPDATE medical_records
                    SET record_hash = %s, transaction_hash = %s
                    WHERE record_id = %s
                """, (record_hash, transaction_hash, record_id))

                connection.commit()
                flash(
                    f"Record #{record_id} saved and secured on blockchain.",
                    "success"
                )

            except Exception as blockchain_error:
                flash(
                    f"Record saved in MySQL, but blockchain storage failed: {blockchain_error}",
                    "error"
                )

            cursor.close()
            connection.close()
            return redirect(url_for("records"))

        except Exception as error:
            if "connection" in locals() and connection.is_connected():
                connection.rollback()
                connection.close()
            flash("Could not save record: " + str(error), "error")

    return render_template("add_record.html", patients=patients)


# ---------------- PATIENT PORTAL ----------------

@app.route("/patient")
@role_required("patient")
def patient_dashboard():
    patient_id = session["patient_id"]

    connection = get_connection()
    cursor = connection.cursor(dictionary=True)

    cursor.execute("""
        SELECT patient_id, name, age, gender, phone, created_at
        FROM patients
        WHERE patient_id = %s
    """, (patient_id,))
    patient = cursor.fetchone()

    cursor.execute("""
        SELECT COUNT(*) AS total
        FROM medical_records
        WHERE patient_id = %s
    """, (patient_id,))
    total_records = cursor.fetchone()["total"]

    cursor.execute("""
        SELECT record_id, diagnosis, prescription,
               doctor_name, record_hash, created_at
        FROM medical_records
        WHERE patient_id = %s
        ORDER BY record_id DESC
    """, (patient_id,))
    records = cursor.fetchall()

    cursor.close()
    connection.close()

    return render_template(
        "patient_dashboard.html",
        patient=patient,
        total_records=total_records,
        records=records
    )


# ---------------- RECORD HISTORY AND VERIFICATION ----------------

@app.route("/records")
@login_required
def records():
    connection = get_connection()
    cursor = connection.cursor(dictionary=True)

    if session["role"] == "doctor":
        cursor.execute("""
            SELECT
                mr.record_id, mr.patient_id, p.name AS patient_name,
                mr.diagnosis, mr.prescription, mr.doctor_name,
                mr.record_hash, mr.transaction_hash, mr.created_at
            FROM medical_records mr
            JOIN patients p ON p.patient_id = mr.patient_id
            JOIN doctor_patient dp ON dp.patient_id = mr.patient_id
            WHERE dp.doctor_id = %s
            ORDER BY mr.record_id DESC
        """, (session["doctor_id"],))
    else:
        cursor.execute("""
            SELECT
                mr.record_id, mr.patient_id, p.name AS patient_name,
                mr.diagnosis, mr.prescription, mr.doctor_name,
                mr.record_hash, mr.transaction_hash, mr.created_at
            FROM medical_records mr
            JOIN patients p ON p.patient_id = mr.patient_id
            WHERE mr.patient_id = %s
            ORDER BY mr.record_id DESC
        """, (session["patient_id"],))

    all_records = cursor.fetchall()
    cursor.close()
    connection.close()

    return render_template("records.html", records=all_records)


@app.route("/verify/<int:record_id>")
@login_required
def verify_record(record_id):
    connection = get_connection()
    cursor = connection.cursor(dictionary=True)

    cursor.execute("""
        SELECT mr.record_id, mr.patient_id, mr.diagnosis,
               mr.prescription, mr.doctor_name, mr.record_hash,
               mr.transaction_hash, mr.created_at, p.name AS patient_name
        FROM medical_records mr
        JOIN patients p ON p.patient_id = mr.patient_id
        WHERE mr.record_id = %s
    """, (record_id,))

    record = cursor.fetchone()

    if not record:
        cursor.close()
        connection.close()
        flash("Record not found.", "error")
        return redirect(url_for("records"))

    if session["role"] == "patient":
        allowed = record["patient_id"] == session["patient_id"]
    else:
        cursor.execute("""
            SELECT assignment_id
            FROM doctor_patient
            WHERE doctor_id = %s AND patient_id = %s
        """, (session["doctor_id"], record["patient_id"]))
        allowed = cursor.fetchone() is not None

    cursor.close()
    connection.close()

    if not allowed:
        flash("You are not authorized to view this record.", "error")
        return redirect(url_for("dashboard"))

    if not record["record_hash"]:
        return render_template(
            "verify_result.html",
            record=record,
            verified=False,
            db_matches=False,
            chain_matches=False,
            current_hash=None
        )

    record_data = {
        "record_id": int(record["record_id"]),
        "patient_id": int(record["patient_id"]),
        "diagnosis": record["diagnosis"],
        "prescription": record["prescription"] or "",
        "doctor_name": record["doctor_name"] or ""
    }

    try:
        current_hash = calculate_record_hash(record_data)
        db_matches = current_hash == record["record_hash"]
        chain_matches = verify_hash_on_blockchain(
            record_id, current_hash
        )
        verified = db_matches and chain_matches

        return render_template(
            "verify_result.html",
            record=record,
            verified=verified,
            db_matches=db_matches,
            chain_matches=chain_matches,
            current_hash=current_hash
        )

    except Exception as error:
        flash("Blockchain verification error: " + str(error), "error")
        return redirect(url_for("records"))


if __name__ == "__main__":
    app.run(debug=True)
